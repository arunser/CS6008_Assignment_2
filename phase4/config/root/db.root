$TTL 3600
@       IN  SOA ns.root. admin.root. (
                2026102201 ; serial
                3600       ; refresh
                900        ; retry
                604800     ; expire
                3600 )     ; negative cache TTL
@           IN  NS  ns.root.
ns.root.    IN  A   172.16.3.10
; ---- delegate the com. zone to tld-ns ----
com.        IN  NS  ns.com.
ns.com.     IN  A   172.16.3.20   ; glue